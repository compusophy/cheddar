# the house wallet. it takes the stakes, pays the prizes, and pays for the model, one payment per reply.
# generate with `npm run keygen`. there is no model api key: see "it pays for its own thoughts" in the readme.
AGENT_PRIVATE_KEY=
# the models, by their openrouter names. MODEL plays (paid per reply, so small and quick);
# PATCH_MODEL rewrites the rules after a loss; MACHINE_MODEL is the machine player (default: MODEL).
# MODEL=google/gemini-2.5-flash-lite
# PATCH_MODEL=google/gemini-3.8-flash
# where the model is bought and how it is paid. the defaults buy from openrouter through tempo's
# paid proxy, in USDC.e on tempo MAINNET (the proxies take real dollars even when the game is on testnet).
# THINK_URL=https://openrouter.mpp.tempo.xyz/v1/chat/completions
# THINK_NETWORK=mainnet
# THINK_TOKEN=
# THINK_KEY=              # a different wallet to think with. default: AGENT_PRIVATE_KEY
# THINK_MODE=             # who pays the network fee on a thought. unset: the seller, with the house as fallback. push: always the house. pull: only the seller.
# the ceilings between the model and the wallet: per thought, per day, and the machine's own allowance.
# THINK_MAX_PRICE=0.05
# PATCH_MAX_PRICE=0.25
# THINK_DAILY_CAP=5
# MACHINE_DAILY_CAP=0.5
# REGRESSION_MAX=30
# PATCH_TOKENS=4096       # room for one rule rewrite. the rules run past a thousand tokens.
# RULES_WORDS=800         # the patcher is told to keep the rules under this many words.
# LESSON_SECONDS=200      # how long one lesson may take. the function it runs in is killed at 300.
# agents buy a game over http 402 at /api/agent/play. MPP_CREDITS=1 also accepts card-funded tempo
# credits: leave it off until you have watched one such payment and seen who it names as the payer.
# MPP_SECRET_KEY=         # default: derived from the house key
# MPP_CREDITS=0
ADMIN_TOKEN=
PORT=3000
# where the money lives. testnet (the default) is play money and needs nothing else.
# mainnet is real money and will not start without the two TOKEN_ lines. see "real money" in the readme.
NETWORK=testnet
# TOKEN_ADDRESS=
# TOKEN_SYMBOL=
# the economy. each has a default in src/game.ts; set one here to change it without touching code.
# GRANTS_PER_DAY=200       # testnet only: how many purses a day the house stands a play dollar. each buys three games of thinking.
# GRANTS_PER_VISITOR=10    # testnet only: and how many of those one visitor's network may have.
# RATE_GLOBAL=120         # messages a minute across everyone. past it a player waits a few seconds; the page resends for them.
# RATE_PLAYER=15           # messages a minute from one purse.
# STAKE=0.25
# JACKPOT_SHARE=0.8
# JACKPOT_SEED=1          # the pot after each win, from the house's pocket. default: 1 on testnet, 0 on mainnet.
# DAILY_CAP=100
# PURSE_DAILY_CAP=20
# a database remembers the network it was started on and will not run under the other. this moves it across,
# pot and debts and all. a reset (npm run reset) is the clean way: it wipes the ledger for the network that runs it.
# ALLOW_NETWORK_CHANGE=0
# the operator's two switches. CLOSED=1 stops new games. PAYOUTS_OFF=1 holds every payout (wins stay owed).
# CLOSED=0
# PAYOUTS_OFF=0
# the autonomous attacker. BOT=0 disables it.
BOT=1
BOT_PERIOD_MS=90000
